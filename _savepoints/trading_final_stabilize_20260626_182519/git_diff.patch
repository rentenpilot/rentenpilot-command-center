-.sig-badge { background: rgba(0,255,102,0.2); border: 1px solid var(--green); color: var(--green); padding: 4px 12px; font-family: 'Orbitron', sans-serif; font-weight: 700; border-radius: 4px; }
-.sig-conf { font-size: 9px; text-align: right; }
-.tc-levels { display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; font-size: 10px; font-weight: 600; text-align: center; }
+.trading-content {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+.tc-kicker {
+  font-size: 8px;
+  color: var(--text-secondary);
+  letter-spacing: 1.8px;
+  text-transform: uppercase;
+}
+.tc-assets {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.tc-assets button {
+  flex: 1 1 64px;
+  min-width: 64px;
+  padding: 7px 8px 6px;
+  background: rgba(255,255,255,0.04);
+  border: 1px solid rgba(0,212,255,0.08);
+  border-radius: 6px;
+  color: var(--text-primary);
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 2px;
+  text-align: center;
+  transition: 0.2s;
+}
+.tc-assets button b {
+  font-size: 9px;
+  font-weight: 700;
+  letter-spacing: 0.4px;
+}
+.tc-assets button small {
+  color: var(--text-secondary);
+  font-size: 7px;
+  letter-spacing: 0.8px;
+}
+.tc-assets button.active {
+  background: rgba(0, 255, 102, 0.16);
+  border-color: rgba(0, 255, 102, 0.9);
+  color: #fff;
+  box-shadow: 0 0 18px rgba(0, 255, 102, 0.18);
+}
+.tc-assets button[data-symbol="US500"],
+.tc-assets button[data-symbol="GER40"] {
+  background: rgba(140, 140, 140, 0.08);
+  border-color: rgba(140, 140, 140, 0.18);
+}
+.tc-live-main {
+  display: grid;
+  grid-template-columns: 0.8fr 1.2fr;
+  gap: 10px;
+  align-items: end;
+}
+.tc-live-main > div,
+.tc-data-cell {
+  background: rgba(0, 0, 0, 0.18);
+  border: 1px solid rgba(0,212,255,0.08);
+  border-radius: 8px;
+  padding: 10px 12px;
+}
+.tc-symbol {
+  font-family: 'Orbitron', sans-serif;
+  font-size: 20px;
+  font-weight: 800;
+  line-height: 1;
+  margin-top: 4px;
+}
+.tc-price {
+  font-family: 'Orbitron', sans-serif;
+  font-size: 30px;
+  font-weight: 800;
+  color: var(--green);
+  line-height: 1;
+  letter-spacing: 0.5px;
+  margin-top: 2px;
+}
+.tc-data-grid {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+.tc-data-cell {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+.tc-data-cell span,
+.tc-footer-line span {
+  font-size: 7px;
+  letter-spacing: 1px;
+  color: var(--text-secondary);
+  text-transform: uppercase;
+}
+.tc-data-cell strong,
+.tc-footer-line strong {
+  font-family: 'Orbitron', sans-serif;
+  font-size: 11px;
+  line-height: 1;
+  color: #fff;
+  overflow-wrap: anywhere;
+}
+.tc-footer-line {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 10px;
+  border-top: 1px solid var(--border);
+  padding-top: 8px;
+}
+.tc-error {
+  min-height: 14px;
+  color: var(--orange);
+  font-size: 10px;
+}
+.tc-chart {
+  height: 56px;
+  padding: 8px 10px;
+  background: linear-gradient(180deg, rgba(0,212,255,0.05), rgba(0,0,0,0.08));
+  border: 1px solid rgba(0,212,255,0.08);
+  border-radius: 8px;
+}
+.tc-chart svg {
+  width: 100%;
+  height: 100%;
+}
 
 .cost-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; align-items: stretch; }
 .cost-box { min-height: 70px; height: auto; background: rgba(0,0,0,0.3); border: 1px solid rgba(0,212,255,0.1); border-radius: 4px; padding: 10px 12px; display: flex; flex-direction: column; justify-content: center; position: relative; }
